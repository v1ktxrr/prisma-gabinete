{
  "name": "gabinete-virtual",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev",
    "build": "next build --webpack",
    "build:turbopack": "next build",
    "cloudflare-build": "npx --legacy-peer-deps @cloudflare/next-on-pages && echo '_worker.js' > .vercel/output/static/.assetsignore",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npx --legacy-peer-deps @opennextjs/cloudflare build && npx --legacy-peer-deps @opennextjs/cloudflare deploy",
    "graph": ".venv/bin/graphify extract . --code-only && .venv/bin/graphify cluster-only .",
    "graph:update": ".venv/bin/graphify update ."
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
