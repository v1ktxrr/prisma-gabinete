# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://sua-instancia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Application URL (usado para links de convite e redirecionamentos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Administradores de Infraestrutura (Cockpit /deviktor-sys)
# Lista de e-mails separados por vírgula autorizados a acessar o cockpit de root
DEV_EMAILS="admin@exemplo.com,dev@exemplo.com"

# Integrações Opcionais
# Google Apps Script para sincronização unidirecional de agenda
GOOGLE_APPS_SCRIPT_URL=

# Resend para envio de e-mails transacionais
RESEND_API_KEY=

# Apify para extração de métricas de redes sociais (Instagram/Reels)
APIFY_API_TOKEN=
